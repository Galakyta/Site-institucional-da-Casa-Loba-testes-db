---
// Página Meu Perfil, com o cabeçalho no estado logado. Por hora, só dá para acessar com o endereço localhost / perfil
// Sem rodapé por enquanto: o rodapé da landing ainda não é um componente.
import Layout from "../layouts/Layout.astro";
import Cabecalho from "../components/Cabecalho.astro";
import { usuariaMock } from "../lib/usuaria-mock";

// PLACEHOLDER: dados de usuário mock. Para virar funcional, a página
// precisa ler o user logado na sessão do Wix e redirecionar quem não estiver logada.
const usuaria = usuariaMock;
---

<Layout>
  <Cabecalho usuaria={usuaria} solido />

  <main class="perfil">
    <!-- Arcos decorativos, no padrão do hero -->
    <div class="perfil__arco perfil__arco--topo" aria-hidden="true"></div>
    <div class="perfil__arco" aria-hidden="true"></div>

    <div class="container perfil__inner">
      <h1 class="perfil__titulo">Meu Perfil</h1>

      <!-- PLACEHOLDER: os campos desta página não salvam nada (o PDF não tem botão de salvar).
           Para virar funcionais, precisam gravar no perfil do membro no Wix. -->

      <!-- nome e imagem -->
      <section class="perfil__secao perfil__grade" aria-label="Nome e imagem de perfil">
        <label class="campo">
          <span>Nome</span>
          <input class="campo__entrada" type="text" name="nome" autocomplete="given-name" value={usuaria.nome} />
        </label>

        <div class="campo">
          <span>Imagem de Perfil</span>
          <!-- PLACEHOLDER: botão sem função. Para virar funcional, precisa do envio
               da imagem para o perfil do membro no Wix. -->
          <button type="button" class="perfil__foto" aria-label="Alterar imagem de perfil">
            {usuaria.imagem ? (
              <img src={usuaria.imagem} alt="" />
            ) : (
              <span class="perfil__camera">
                <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linejoin="round"
                  />
                  <circle cx="12" cy="13.5" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </span>
            )}
          </button>
        </div>
      </section>

      <!-- endereço -->
      <section class="perfil__secao">
        <h2 class="perfil__subtitulo">Endereço</h2>
        <div class="perfil__grade">
          <label class="campo">
            <span>Rua</span>
            <input class="campo__entrada" type="text" name="rua" autocomplete="address-line1" />
          </label>
          <label class="campo">
            <span>Complemento</span>
            <input class="campo__entrada" type="text" name="complemento" autocomplete="address-line2" />
          </label>
          <label class="campo">
            <span>Cidade</span>
            <input class="campo__entrada" type="text" name="cidade" autocomplete="address-level2" />
          </label>
          <label class="campo">
            <span>Código postal (CEP)</span>
            <input class="campo__entrada" type="text" inputmode="numeric" name="cep" autocomplete="postal-code" />
          </label>
          <label class="campo">
            <span>País</span>
            <input class="campo__entrada" type="text" name="pais" autocomplete="country-name" />
          </label>
        </div>
      </section>

      <!-- informações de login -->
      <section class="perfil__secao">
        <h2 class="perfil__subtitulo">Informações de login</h2>
        <p class="perfil__descricao">Veja e atualize seu email e senha de login.</p>
        <div class="perfil__grade perfil__login">
          <div>
            <p>Email:</p>
            <p>{usuaria.email}</p>
          </div>
          <!-- PLACEHOLDER: sem função. Para virar funcional, precisa da troca de email do Wix. -->
          <button type="button" class="btn btn--sm btn--vermelho">alterar email</button>

          <div>
            <p>Senha:</p>
            <p><span role="img" aria-label="senha oculta">●●●●●●</span></p>
          </div>
          <!-- PLACEHOLDER: sem função. Para virar funcional, precisa da troca de senha do Wix. -->
          <button type="button" class="btn btn--sm btn--vermelho">alterar senha</button>
        </div>
      </section>

      <!-- minha carteira -->
      <!-- PLACEHOLDER: seção apenas visual, sem função. Para virar funcional, precisa
           salvar formas de pagamento pelo meio de pagamento escolhido. -->
      <section class="perfil__secao">
        <h2 class="perfil__subtitulo">Minha carteira</h2>
        <p class="perfil__descricao">Salve suas informações de pagamento para um checkout mais rápido.</p>
        <button type="button" class="btn btn--sm btn--vermelho perfil__adicionar">+ adicionar</button>
      </section>

      <!-- minha assinatura -->
      <!-- PLACEHOLDER: seção apenas visual, com plano e benefícios do mock. Para virar
           funcional, precisa ler o plano da usuária nos planos do Wix, e "alterar plano"
           precisa levar à troca de plano. -->
      <section class="perfil__secao">
        <h2 class="perfil__subtitulo">Minha assinatura</h2>
        <p class="perfil__descricao">Confira a sua assinatura e seus benefícios.</p>
        <div class="perfil__grade perfil__assinatura">
          <span class="plano__selo plano__selo--rosa perfil__selo">plano {usuaria.plano.nome}</span>
          <button type="button" class="btn btn--sm btn--vermelho perfil__alterar-plano">alterar plano</button>
          <ul class="perfil__beneficios">
            {usuaria.plano.beneficios.map((beneficio) => <li>{beneficio}</li>)}
          </ul>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .perfil {
    position: relative;
    overflow: hidden;
    min-height: 100vh;
    padding: 140px 0 120px;
  }

  /* Arcos: mesmas medidas e reduções de .hero__arco em src/styles/global.css */
  .perfil__arco {
    position: absolute;
    right: -120px;
    bottom: -1px;
    width: 520px;
    height: 520px;
    background: var(--vermelho);
    border-radius: 260px 260px 0 0;
    z-index: 0;
  }

  .perfil__arco--topo {
    top: -200px;
    left: -120px;
    right: auto;
    bottom: auto;
    width: 400px;
    height: 400px;
    border-radius: 0 0 200px 200px;
  }

  /* Coluna central de 760px, como no PDF */
  .perfil__inner {
    position: relative;
    z-index: 1;
    max-width: calc(760px + 48px);
  }

  .perfil__titulo {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 32px;
  }

  .perfil__secao + .perfil__secao {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--ameixa);
  }

  .perfil__subtitulo {
    font-size: 1.25rem;
  }

  .perfil__descricao {
    margin-top: 6px;
    opacity: 0.85;
  }

  .perfil__grade {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 96px;
    row-gap: 16px;
    align-items: start;
  }

  .perfil__subtitulo + .perfil__grade,
  .perfil__descricao + .perfil__grade {
    margin-top: 16px;
  }

  /* Imagem de perfil: círculo em água com a câmera num círculo branco */
  .perfil__foto {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100px;
    height: 100px;
    border: none;
    border-radius: var(--capsula);
    overflow: hidden;
    background: var(--agua);
    color: var(--ameixa);
    cursor: pointer;
    transition: transform 0.2s ease;
  }

  .perfil__foto:hover {
    transform: translateY(-2px);
  }

  .perfil__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .perfil__camera {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--capsula);
    background: #ffffff;
  }

  .perfil__login {
    align-items: center;
  }

  .perfil__login .btn,
  .perfil__adicionar,
  .perfil__alterar-plano {
    justify-self: start;
  }

  .perfil__adicionar {
    margin-top: 16px;
  }

  .perfil__assinatura {
    grid-template-areas:
      "selo     botao"
      "lista    .";
    align-items: center;
  }

  .perfil__selo {
    grid-area: selo;
    justify-self: start;
    align-self: center;
  }

  .perfil__alterar-plano {
    grid-area: botao;
  }

  .perfil__beneficios {
    grid-area: lista;
    list-style: disc;
    padding-left: 1.25em;
  }

  @media (max-width: 860px) {
    .perfil {
      padding: 120px 0 80px;
    }

    .perfil__grade {
      column-gap: var(--gap);
    }

    .perfil__arco {
      width: 320px;
      height: 320px;
      right: -80px;
      border-radius: 160px 160px 0 0;
    }

    .perfil__arco--topo {
      top: -120px;
      left: -80px;
      width: 240px;
      height: 240px;
      border-radius: 0 0 120px 120px;
    }
  }

  @media (max-width: 560px) {
    .perfil__grade {
      grid-template-columns: 1fr;
    }

    .perfil__assinatura {
      grid-template-areas:
        "selo"
        "lista"
        "botao";
    }

    .perfil__arco {
      width: 220px;
      height: 220px;
      right: -60px;
      border-radius: 110px 110px 0 0;
    }

    .perfil__arco--topo {
      top: -80px;
      left: -60px;
      width: 160px;
      height: 160px;
      border-radius: 0 0 80px 80px;
    }
  }
</style>
